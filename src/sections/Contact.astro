<section id="contact" class="py-20 px-4 sm:px-6 max-w-6xl mx-auto">
        <div class="glass-card rounded-3xl p-8 md:p-12 text-left">
            <span class="text-xs font-mono tracking-widest text-emerald-500 uppercase font-semibold">
                Contact
            </span>
            <h2 class="text-3xl md:text-4xl font-extrabold mt-2 mb-6">
                Just contact us and that's it.
            </h2>

            <form id="contactForm" class="space-y-5 max-w-2xl">
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                    <div>
                        <label for="name" class="block text-xs font-semibold mb-2">
                            Your Name
                        </label>
                        <input type="text" id="name" required placeholder="Silava"
                            class="w-full bg-slate-100/70 dark:bg-slate-800/60 border border-slate-300 dark:border-slate-700/70 rounded-xl px-4 py-3 text-sm">
                    </div>

                    <div>
                        <label for="email" class="block text-xs font-semibold mb-2">
                            Email Address
                        </label>
                        <input type="email" id="email" required placeholder="silava@company.com"
                            class="w-full bg-slate-100/70 dark:bg-slate-800/60 border border-slate-300 dark:border-slate-700/70 rounded-xl px-4 py-3 text-sm">
                    </div>
                </div>

                <div>
                    <label for="message" class="block text-xs font-semibold mb-2">
                        Message us
                    </label>
                    <textarea id="message" rows="4" required placeholder="Message"
                        class="w-full bg-slate-100/70 dark:bg-slate-800/60 border border-slate-300 dark:border-slate-700/70 rounded-xl px-4 py-3 text-sm resize-none"></textarea>
                </div>

                <button type="submit"
                    class="w-full py-3.5 rounded-xl bg-cyan-500 text-white font-bold text-sm cursor-pointer">
                    Send Message.
                </button>
            </form>
        </div>
    </section>